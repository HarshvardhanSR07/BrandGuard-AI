# Environment Configuration
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/brandguard_dev

# JWT Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# LLM Provider Configuration (provider-agnostic)
# Options: 'mock' | 'openrouter' | 'openai' | 'gemini' | 'disabled'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1
WORKSPACE_DAILY_LLM_BUDGET=50

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_AUTH_MAX=10

# File Upload Settings & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_EXTRACTED_TEXT_LENGTH=100000
PDF_PARSE_TIMEOUT_MS=5000

# OCR Worker (Optional Python Service)
OCR_WORKER_ENABLED=false
OCR_WORKER_URL=http://localhost:8000

# Frontend (apps/web)
VITE_API_URL=http://localhost:4000/api
