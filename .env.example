# Environment Configuration
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/brandguard_dev

# JWT Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# LLM Provider Configuration (provider-agnostic)
# Options: 'mock' | 'openrouter' | 'openai' | 'gemini' | 'disabled'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1
WORKSPACE_DAILY_LLM_BUDGET=50

# Cognee Memory Layer (required in production — omit to run in offline/mock mode)
LAX_MEMORY_API_KEY=

# Security & CORS
# Comma-separated list of allowed frontend origins (no wildcards)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_AUTH_MAX=10

# OAuth Providers (required in production to prevent token-substitution attacks)
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# File Upload Settings & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_EXTRACTED_TEXT_LENGTH=100000
PDF_PARSE_TIMEOUT_MS=5000

# OCR Worker (Optional Python Service)
OCR_WORKER_ENABLED=false
OCR_WORKER_URL=http://localhost:8000

# Frontend (apps/web) — REQUIRED: set your Clerk publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_URL=http://localhost:4000/api
