# Copy to .env (never commit .env). All values here are FAKE placeholders.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/brandguard
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1h
JWT_ISSUER=brandguard
JWT_AUDIENCE=brandguard-api
BCRYPT_COST=12
AUDIT_HASH_CHAIN=on
MAX_EXTRACTED_TEXT_BYTES=200000
MAX_UPLOAD_BYTES=10485760
# Comma-separated browser origins allowed to call the API (your Vercel URL). Empty = no cross-origin access.
CORS_ORIGINS=http://localhost:5173
# on = a draft can only be APPROVED if the latest analysis of its current revision is 'complete' (no false green)
REQUIRE_COMPLETE_ANALYSIS_FOR_APPROVAL=off
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000

# Optional: seed passwords. If unset, random ones are generated and written to
# .seed-credentials.local.json (git-ignored).
# SEED_PASSWORD_USER1=
# SEED_PASSWORD_USER2=
# SEED_PASSWORD_USER3=
# SEED_PASSWORD_USER4=
