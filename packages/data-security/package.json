{
  "name": "@brandguard/data-security",
  "version": "0.1.0",
  "private": true,
  "description": "BrandGuard AI - database and security layer (Mongoose models, scoped repositories, auth, RBAC, audit chain)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "seed": "tsx src/seed/seed.ts",
    "seed:reset": "tsx src/seed/seed.ts --reset",
    "user:deactivate": "tsx src/seed/deactivateUser.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "mongoose": "^8.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "mongodb-memory-server": "^9.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
